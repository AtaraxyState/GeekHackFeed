# Scraped content -- other people's forum posts and product renders.
# All of it regenerates from a single `python scrape.py` run.
images/
cache-board*.json
covers-board*.json
feed-board*.html
feed-vendors.html

# Signing key. build.ps1 regenerates a local debug keystore on first run.
android/debug.keystore

# Build output. The APK is published by the release workflow rather than
# committed, so the repo never disagrees with the Releases page.
android/build/
android/*.apk
__pycache__/
*.py[cod]
*.tmp

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
android/*.idsig

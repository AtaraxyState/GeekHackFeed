# Scraped content -- other people's forum posts and product renders.
# All of it regenerates from a single `python scrape.py` run.
images/
cache-board*.json
covers-board*.json
feed-board*.html
feed-vendors.html

# Signing keys, anywhere in the tree. The release keystore is prepared at the
# repo root per the README, and committing it to a public repo would hand over
# the identity every release is signed with.
*.jks
*.keystore
*.jks.b64
android/debug.keystore

# Build output. The APK is published by the release workflow rather than
# committed, so the repo never disagrees with the Releases page.
android/build/
android/*.apk
__pycache__/
*.py[cod]
*.tmp

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
android/*.idsig
